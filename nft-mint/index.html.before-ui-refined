<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>ANGRY NFT · Public Mint</title>
<style>
:root{color-scheme:dark;--bg:#080808;--card:#111;--card2:#171717;--line:#2b2b2b;--orange:#ff7a00;--orange2:#ff9a33;--text:#f5f5f5;--muted:#aaa;--good:#78e08f;--bad:#ff7b7b}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% -10%,#2a1400 0,#0b0b0b 34%,#050505 100%);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;min-height:100vh}
a{color:inherit}.wrap{width:min(980px,100%);margin:0 auto;padding:16px}.top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.04em}.face{width:38px;height:38px;border-radius:11px;background:var(--orange);display:grid;place-items:center;font-size:23px}.pill{border:1px solid #52300d;background:#1c1105;color:#ffc17e;padding:6px 9px;border-radius:999px;font-size:12px}.card{background:linear-gradient(180deg,rgba(24,24,24,.96),rgba(12,12,12,.98));border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 18px 50px rgba(0,0,0,.28)}.hero{margin-bottom:12px}.hero h1{font-size:clamp(24px,7vw,40px);margin:4px 0 6px}.muted{color:var(--muted);font-size:13px;line-height:1.45}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}.stat{background:#0d0d0d;border:1px solid #262626;border-radius:13px;padding:10px}.stat small{display:block;color:#999;font-size:11px}.stat strong{display:block;margin-top:4px;font-size:15px}.btn{appearance:none;border:1px solid #444;background:#1c1c1c;color:#fff;border-radius:13px;padding:13px 14px;font-weight:800;font-size:14px;cursor:pointer}.btn.primary{border-color:#d86500;background:linear-gradient(180deg,#ff8b1e,#e66500);color:#120800}.btn:disabled{opacity:.45;cursor:not-allowed}.wallet{display:flex;gap:8px;align-items:center}.status{margin-top:10px;padding:11px 12px;border:1px solid #2a2a2a;border-radius:12px;background:#0d0d0d;color:#bbb;font-size:13px;line-height:1.45}.status.good{border-color:#214d2c;color:#9aefaa}.status.bad{border-color:#5a2424;color:#ffaaaa}.field{margin-top:12px}.field label{display:block;color:#bbb;font-size:12px;margin-bottom:6px}.field input{width:100%;padding:12px;border-radius:12px;border:1px solid #333;background:#090909;color:#fff;font-size:15px;outline:none}.field input:focus{border-color:var(--orange)}.actions{display:grid;gap:8px;margin-top:12px}.linkbtn{display:block;text-align:center;text-decoration:none}.hidden{display:none!important}@media(max-width:640px){.wrap{padding:10px}.stats{grid-template-columns:1fr 1fr}.top{align-items:flex-start}.wallet{flex-direction:column;align-items:stretch}.card{padding:13px;border-radius:15px}}

.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}.nft{position:relative;background:#0b0b0b;border:1px solid #2d2d2d;border-radius:15px;overflow:hidden;cursor:pointer;transition:.14s}.nft:hover{border-color:#555}.nft.selected{border:2px solid var(--orange);box-shadow:0 0 0 2px rgba(255,122,0,.14)}.nft.sold{opacity:.55;cursor:not-allowed}.imgbox{aspect-ratio:1/1;background:#181818;display:grid;place-items:center;overflow:hidden}.imgbox img{width:100%;height:100%;object-fit:cover;display:block}.imgph{font-size:34px}.nftmeta{padding:9px}.nftmeta b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:13px}.nftmeta small{color:#999}.badge{position:absolute;top:7px;right:7px;padding:4px 7px;border-radius:999px;background:rgba(0,0,0,.8);font-size:10px;font-weight:800}.badge.available{color:#b6ffbf}.badge.sold{color:#ffaaaa}.mintbar{position:sticky;bottom:8px;margin-top:13px;background:rgba(12,12,12,.94);backdrop-filter:blur(10px);border:1px solid #333;border-radius:16px;padding:10px;z-index:5}.mintbar .btn{width:100%}.loadmore{width:100%;margin-top:10px}@media(max-width:700px){.gallery{grid-template-columns:repeat(2,1fr)}}
</style></head><body><main class="wrap">
<header class="top"><div class="brand"><div class="face">😡</div><div>ANGRY NFT<br><span class="muted">Public Mint</span></div></div><span class="pill">Ethereum Sepolia · Beta</span></header>
<section class="card hero"><div class="muted">COLLECTION</div><h1 id="collectionName">Loading collection…</h1><div class="muted" id="collectionHint">Open the shared mint link, connect your wallet, choose an NFT, and mint.</div>
<div class="stats"><div class="stat"><small>Minted</small><strong id="minted">—</strong></div><div class="stat"><small>Remaining</small><strong id="remaining">—</strong></div><div class="stat"><small>Mint price</small><strong id="price">—</strong></div><div class="stat"><small>Max / wallet</small><strong id="limit">—</strong></div></div>
<div class="wallet" style="margin-top:12px"><button class="btn" id="connectBtn">Connect Wallet</button><div class="muted" id="walletText">Wallet not connected</div></div><div class="status" id="status">Loading collection information…</div></section>
<section class="card"><div style="display:flex;align-items:end;justify-content:space-between;gap:10px"><div><b>Choose your NFT</b><div class="muted">Tap one available image. Sold NFTs cannot be selected.</div></div><span class="pill" id="publicState">Loading…</span></div><div class="gallery" id="gallery"></div><button class="btn loadmore hidden" id="loadMoreBtn">Show more NFTs</button></section>
<div class="mintbar"><div class="muted" id="selectedText" style="margin:0 2px 8px">Choose an available NFT above.</div><button class="btn primary" id="mintBtn" disabled>Choose an NFT</button></div>
</main>
<script type="module">
import {BrowserProvider,Contract,JsonRpcProvider,formatEther} from "https://cdn.jsdelivr.net/npm/ethers@6.15.0/+esm";
const $=id=>document.getElementById(id);
const ABI=["function name() view returns(string)","function maxSupply() view returns(uint256)","function maxPerWallet() view returns(uint256)","function metadataRoot() view returns(bytes32)","function manifestURI() view returns(string)","function publicMintEnabled() view returns(bool)","function totalSupply() view returns(uint256)","function remainingSupply() view returns(uint256)","function mintedByWallet(address) view returns(uint256)","function ownerOf(uint256) view returns(address)","function mintPrice() view returns(uint256)","function publicMint(uint256,string,bytes32[]) payable"];
const PAGE_SIZE=12; let visibleCount=PAGE_SIZE; let data=null; let selected=null; let account=""; let readProvider=null;
function setStatus(text,kind=""){const el=$("status");el.textContent=text;el.className="status"+(kind?" "+kind:"")}
function short(a){return a?a.slice(0,6)+"…"+a.slice(-4):""}
function contractFromUrl(){const q=new URLSearchParams(location.search).get("contract")||"";if(/^0x[a-fA-F0-9]{40}$/.test(q))return q;try{const d=JSON.parse(localStorage.getItem("angry:last-sepolia-collection-v1")||"null");if(/^0x[a-fA-F0-9]{40}$/.test(d?.address||""))return d.address}catch{}return ""}
function ipfsCandidates(uri){const v=String(uri||"").trim();if(/^https:\/\//i.test(v))return[v];if(!/^ipfs:\/\//i.test(v))return[];const p=v.replace(/^ipfs:\/\//i,"").replace(/^ipfs\//i,"");return["https://gateway.pinata.cloud/ipfs/"+p,"https://ipfs.io/ipfs/"+p,"https://dweb.link/ipfs/"+p]}
function imageUrl(uri){const c=ipfsCandidates(uri);return c[0]||(/^https:\/\//i.test(uri||"")?uri:"")}
async function fetchJson(uri){let last;for(const url of ipfsCandidates(uri)){try{const c=new AbortController();const t=setTimeout(()=>c.abort(),15000);const r=await fetch(url,{cache:"force-cache",signal:c.signal});clearTimeout(t);if(!r.ok)throw new Error("HTTP "+r.status);return await r.json()}catch(e){last=e}}throw last||new Error("Unable to load IPFS metadata")}
async function getReadProvider(){if(readProvider)return readProvider;for(const rpc of ["https://ethereum-sepolia-rpc.publicnode.com","https://rpc.sepolia.org"]){try{const p=new JsonRpcProvider(rpc,11155111,{staticNetwork:true});await p.getBlockNumber();readProvider=p;return p}catch{}}if(window.ethereum){readProvider=new BrowserProvider(window.ethereum);return readProvider}throw new Error("Ethereum Sepolia connection unavailable")}
async function isMinted(contract,id){try{const owner=await contract.ownerOf(BigInt(id));return !!owner}catch{return false}}
async function loadItem(item,contract){let meta={};try{meta=await fetchJson(item.metadata_uri)}catch{}const minted=await isMinted(contract,item.token_id);return{...item,meta,minted}}
function cardNode(item){const d=document.createElement("button");d.type="button";d.className="nft"+(item.minted?" sold":"")+(selected?.token_id===item.token_id?" selected":"");d.disabled=item.minted;const box=document.createElement("div");box.className="imgbox";const url=imageUrl(item.meta?.image);if(url){const img=document.createElement("img");img.src=url;img.alt=item.meta?.name||("NFT #"+item.token_id);img.loading="lazy";img.onerror=()=>{img.remove();box.textContent="😡"};box.appendChild(img)}else{const p=document.createElement("div");p.className="imgph";p.textContent="😡";box.appendChild(p)}const badge=document.createElement("span");badge.className="badge "+(item.minted?"sold":"available");badge.textContent=item.minted?"SOLD":"AVAILABLE";const meta=document.createElement("div");meta.className="nftmeta";const b=document.createElement("b");b.textContent=item.meta?.name||("NFT #"+item.token_id);const sm=document.createElement("small");sm.textContent="#"+item.token_id;meta.append(b,sm);d.append(box,badge,meta);if(!item.minted)d.addEventListener("click",()=>{selected=item;renderGallery();updateMintButton()});return d}
async function renderGallery(){const g=$("gallery");g.innerHTML="";for(const item of data.items.slice(0,visibleCount))g.appendChild(cardNode(item));$("loadMoreBtn").classList.toggle("hidden",visibleCount>=data.items.length)}
function updateMintButton(){const btn=$("mintBtn");if(!data){btn.disabled=true;btn.textContent="Loading…";return}if(!data.publicEnabled){btn.disabled=true;btn.textContent="Mint is currently closed";return}if(account&&data.maxPerWallet>0&&data.mintedByYou>=data.maxPerWallet){btn.disabled=true;btn.textContent="Wallet mint limit reached";$("selectedText").textContent="You already minted "+data.mintedByYou+" / "+data.maxPerWallet+" allowed NFTs.";return}if(!selected){btn.disabled=true;btn.textContent="Choose an NFT";$("selectedText").textContent="Choose an available NFT above.";return}$("selectedText").textContent="Selected: "+(selected.meta?.name||("NFT #"+selected.token_id))+" · #"+selected.token_id;btn.disabled=false;btn.textContent=account?("Mint · "+formatEther(data.mintPrice)+" ETH + gas"):"Connect Wallet to Mint"}
async function refreshStats(){const p=await getReadProvider();const c=new Contract(data.address,ABI,p);const [minted,remaining,enabled,price]=await Promise.all([c.totalSupply(),c.remainingSupply(),c.publicMintEnabled(),c.mintPrice()]);Object.assign(data,{minted:Number(minted),remaining:Number(remaining),publicEnabled:enabled,mintPrice:price});$("minted").textContent=data.minted+" / "+data.maxSupply;$("remaining").textContent=String(data.remaining);$("price").textContent=formatEther(price)+" ETH";$("publicState").textContent=enabled?"Mint OPEN":"Mint CLOSED";if(account){data.mintedByYou=Number(await c.mintedByWallet(account));$("walletText").textContent=short(account)+" · Minted by you: "+data.mintedByYou}else data.mintedByYou=0;updateMintButton()}
async function loadCollection(){try{const address=contractFromUrl();if(!address)throw new Error("This mint link does not contain a Collection address.");const p=await getReadProvider();const c=new Contract(address,ABI,p);const [name,maxSupply,maxPerWallet,root,manifestUri]=await Promise.all([c.name(),c.maxSupply(),c.maxPerWallet(),c.metadataRoot(),c.manifestURI()]);const manifest=await fetchJson(manifestUri);if(String(manifest.metadata_root||"").toLowerCase()!==String(root).toLowerCase())throw new Error("Collection metadata verification failed.");if(Number(manifest.max_supply)!==Number(maxSupply))throw new Error("Collection supply verification failed.");data={address,name,maxSupply:Number(maxSupply),maxPerWallet:Number(maxPerWallet),manifest,items:[],mintedByYou:0};$("collectionName").textContent=name;$("limit").textContent=data.maxPerWallet===0?"No limit":String(data.maxPerWallet);setStatus("Loading NFT previews…");const first=manifest.items.slice(0,PAGE_SIZE);data.items=await Promise.all(first.map(i=>loadItem(i,c)));if(manifest.items.length>PAGE_SIZE){data.items.push(...manifest.items.slice(PAGE_SIZE).map(i=>({...i,meta:null,minted:null,_unloaded:true})))}selected=data.items.find(x=>x.minted===false)||null;await refreshStats();renderGallery();setStatus("Choose an available NFT, connect your wallet, then mint.","good")}catch(e){setStatus(e?.message||String(e),"bad");$("collectionName").textContent="Collection unavailable"}}
async function loadMore(){if(!data)return;const old=visibleCount;visibleCount=Math.min(data.items.length,visibleCount+PAGE_SIZE);const p=await getReadProvider();const c=new Contract(data.address,ABI,p);const jobs=[];for(let i=old;i<visibleCount;i++){if(data.items[i]?._unloaded)jobs.push((async idx=>{data.items[idx]=await loadItem(data.items[idx],c)})(i))}await Promise.all(jobs);if(!selected)selected=data.items.slice(0,visibleCount).find(x=>x.minted===false)||null;renderGallery();updateMintButton()}
async function ensureSepolia(){const chain=String(await ethereum.request({method:"eth_chainId"})).toLowerCase();if(chain==="0xaa36a7")return;try{await ethereum.request({method:"wallet_switchEthereumChain",params:[{chainId:"0xaa36a7"}]})}catch(e){if(e?.code===4902){await ethereum.request({method:"wallet_addEthereumChain",params:[{chainId:"0xaa36a7",chainName:"Ethereum Sepolia",nativeCurrency:{name:"Sepolia ETH",symbol:"ETH",decimals:18},rpcUrls:["https://rpc.sepolia.org"],blockExplorerUrls:["https://sepolia.etherscan.io"]}]})}else throw e}}
async function connect(){if(!window.ethereum){setStatus("Open this page inside MetaMask or another compatible EVM wallet.","bad");return}try{await ensureSepolia();const accts=await ethereum.request({method:"eth_requestAccounts"});account=accts?.[0]||"";$("connectBtn").textContent=short(account);await refreshStats();setStatus("Wallet connected. Choose an NFT and mint.","good")}catch(e){setStatus("Wallet connection stopped: "+(e?.shortMessage||e?.message||e),"bad")}}
async function mint(){if(!data||!selected)return;if(!account){await connect();return}const btn=$("mintBtn");btn.disabled=true;try{await ensureSepolia();const bp=new BrowserProvider(window.ethereum);const signer=await bp.getSigner();account=await signer.getAddress();const c=new Contract(data.address,ABI,signer);const [enabled,price,mintedBy]=await Promise.all([c.publicMintEnabled(),c.mintPrice(),c.mintedByWallet(account)]);if(!enabled)throw new Error("Public mint is currently closed.");if(data.maxPerWallet>0&&Number(mintedBy)>=data.maxPerWallet)throw new Error("Your wallet has reached the collection mint limit.");if(await isMinted(c,selected.token_id))throw new Error("This NFT was just minted by another collector. Choose another available NFT.");setStatus("Confirm the mint in MetaMask. Price: "+formatEther(price)+" ETH + network gas.");const tx=await c.publicMint(BigInt(selected.token_id),selected.metadata_uri,selected.proof,{value:price});setStatus("Mint sent. Waiting for Ethereum Sepolia confirmation…");await tx.wait();selected.minted=true;selected=null;const p=await getReadProvider();const rc=new Contract(data.address,ABI,p);for(const item of data.items.slice(0,visibleCount)){if(item.minted===false) {item.minted=await isMinted(rc,item.token_id)}}selected=data.items.slice(0,visibleCount).find(x=>x.minted===false)||null;await refreshStats();renderGallery();setStatus("NFT minted successfully. It now belongs to your connected wallet.","good")}catch(e){let m=e?.shortMessage||e?.reason||e?.message||String(e);if(String(m).includes("MAX_PER_WALLET"))m="Your wallet has reached the collection mint limit.";if(String(m).includes("ALREADY_MINTED"))m="That NFT is already sold. Choose another image.";if(String(m).includes("user rejected"))m="Transaction cancelled in MetaMask.";setStatus(m,"bad")}finally{updateMintButton()}}
$("connectBtn").addEventListener("click",connect);$("mintBtn").addEventListener("click",mint);$("loadMoreBtn").addEventListener("click",loadMore);if(window.ethereum){ethereum.on?.("accountsChanged",a=>{account=a?.[0]||"";$("connectBtn").textContent=account?short(account):"Connect Wallet";refreshStats().catch(()=>{})});ethereum.on?.("chainChanged",()=>location.reload())}loadCollection();
</script></body></html>